VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=

# Optional Carto Basemaps key (dashboard → "Your API key"). Without it the map uses Esri.
# VITE_CARTO_API_KEY=

# Required for Realtime: copy from Supabase → Project Settings → API.

# Must match Supabase → Authentication → URL Configuration → Redirect URLs.
# Example: http://localhost:8081 (no trailing slash). If unset, the app uses the browser origin.
# Local Google login also requires these Redirect URLs (Site URL can stay production):
#   http://localhost:8081/**
#   http://localhost:8081/auth/callback
#   http://127.0.0.1:8081/**
#   http://127.0.0.1:8081/auth/callback
# VITE_OAUTH_REDIRECT_ORIGIN=http://localhost:8081